+void ContextImpl::RestoreX87FromHostPC(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPC) {
+  uint32_t Desc {};
+  RIPFromHostPC(Thread, HostPC, nullptr, &Desc);
+  if (!Desc) {
+    return;
+  }
+
   const auto Frame = Thread->CurrentFrame;
-  const uint64_t BlockBegin = Frame->State.InlineJITBlockHeader;
-  const auto Info = GetFrameBlockInfo(Frame);
-  if (!Info.InlineHeader || HostPC < BlockBegin || HostPC >= BlockBegin + Info.InlineTail->Size) {
+  auto& State = Frame->State;
+  const uint32_t Pushed = IR::X87Pending::Top(Desc);
+  const uint32_t Top = (State.flags[X86State::X87FLAG_TOP_LOC] + 8 - Pushed) & 7;
+  State.flags[X86State::X87FLAG_TOP_LOC] = Top;
+
+  for (uint32_t i = 0; i < 8; ++i) {
+    const auto Kind = IR::X87Pending::KindOf(Desc, i);
+    const uint32_t Reg = (Top + i) & 7;
+    const auto& Saved = Frame->X87Pending[IR::X87Pending::SlotOf(Pushed, i)];
+    switch (Kind) {
+    case IR::X87Pending::Unchanged: continue;
+    case IR::X87Pending::Empty: State.AbridgedFTW &= ~(1U << Reg); continue;
+    case IR::X87Pending::F80: memcpy(State.mm[Reg], Saved, sizeof(State.mm[Reg])); break;
+    case IR::X87Pending::Reduced: memcpy(State.mm[Reg], Saved, sizeof(uint64_t)); break;
+    case IR::X87Pending::F64: {
+      double Value;
+      memcpy(&Value, Saved, sizeof(Value));
+      const auto Wide = CPU::OpHandlers<IR::OP_F80CVTTO>::handle8(State.FCW, Value, Frame);
+      memcpy(State.mm[Reg], &Wide, sizeof(State.mm[Reg]));
+      break;
+    }
+    case IR::X87Pending::F32: {
+      float Value;
+      memcpy(&Value, Saved, sizeof(Value));
+      const auto Wide = CPU::OpHandlers<IR::OP_F80CVTTO>::handle4(State.FCW, Value, Frame);
+      memcpy(State.mm[Reg], &Wide, sizeof(State.mm[Reg]));
+      break;
+    }
+    }
+    State.AbridgedFTW |= 1U << Reg;
+  }
+}
