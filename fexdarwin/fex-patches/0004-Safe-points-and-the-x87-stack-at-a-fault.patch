+void Arm64JITCore::EmitEntryPoint(ARMEmitter::BackwardLabel& HeaderLabel, bool CheckTF, uint32_t GuestEntryOffset) {
+  // Darwin port: before the safe point. The trap of the instruction before this one comes before a signal, and a thread that stops
+  // and starts again here has its trap flag blocked for one instruction again (SetFlagsFromCompactedEFLAGS).
   if (CheckTF) {
     EmitTFCheck();
   }
 
+  // Get the address of the JITCodeHeader and store in to the core state.
+  // Darwin port: through SafepointPtr, which makes it a safe point. Before anything else: the thread starts again at the unit's
+  // address, where no effect of the guest has happened and nothing is on the host stack.
+  adr_OrRestart(TMP1, &HeaderLabel);
+  ldr(TMP2, STATE_PTR(CpuStateFrame, SafepointPtr));
+  DebugData->GuestOpcodes.push_back({GuestEntryOffset, GetCursorAddress<uint8_t*>() - CodeData.BlockBegin, 0, 0});
+  str(TMP1, TMP2, 0);
