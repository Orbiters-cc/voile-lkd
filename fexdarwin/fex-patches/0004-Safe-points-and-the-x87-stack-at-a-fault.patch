+// Darwin port: no signal, suspension or exit of the process would reach a thread in a loop of the unit without a safe point.
+bool Arm64JITCore::HasLoopWithoutSafepoint() const {
+  enum : uint8_t { Unseen, Open, Done };
+  fextl::vector<uint8_t> State(BlockHasSafepoint.size(), Unseen);
+  fextl::vector<std::pair<uint32_t, uint8_t>> Path;
+  for (uint32_t Start = 0; Start < State.size(); ++Start) {
+    if (State[Start] != Unseen || BlockHasSafepoint[Start]) {
+      continue;
+    }
+    Path.push_back({Start, 0});
+    State[Start] = Open;
+    while (!Path.empty()) {
+      auto& [Block, Next] = Path.back();
+      if (Next == 2) {
+        State[Block] = Done;
+        Path.pop_back();
+        continue;
+      }
+      const uint32_t To = Next ? BlockSuccessors[Block].second : BlockSuccessors[Block].first;
+      ++Next;
+      if (To == ~0U || BlockHasSafepoint[To] || State[To] == Done) {
+        continue;
+      }
+      if (State[To] == Open) {
+        return true;
+      }
+      State[To] = Open;
+      Path.push_back({To, 0});
+    }
+  }
+  return false;
+}
