+void Arm64JITCore::EmitSafepoint(uint32_t GuestEntryOffset) {
+  ldr(TMP1, STATE_PTR(CpuStateFrame, SafepointPtr));
+  DebugData->GuestOpcodes.push_back({GuestEntryOffset, GetCursorAddress<uint8_t*>() - CodeData.BlockBegin, 0, 0});
