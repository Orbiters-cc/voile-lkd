+bool ContextImpl::SafepointAt(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPC, const uint64_t* HostGPRs, uint64_t* RIP) {
+  // What Arm64JITCore::EmitEntryPoint and EmitSafepoint end with: str TMP1, [TMP2] and ldr xzr, [TMP1].
+  constexpr uint32_t Entry = 0xF900'0000U | (CPU::TMP2.Idx() << 5) | CPU::TMP1.Idx();
+  constexpr uint32_t Loop = 0xF940'0000U | (CPU::TMP1.Idx() << 5) | 31;
+
+  auto& Header = Thread->CurrentFrame->State.InlineJITBlockHeader;
+  const uint32_t Inst = *reinterpret_cast<const uint32_t*>(HostPC);
+  if (Inst == Entry) {
+    // The header's address does not reach the context without the store.
+    Header = HostGPRs[CPU::TMP1.Idx()];
+  } else if (Inst != Loop) {
+    return false;
+  }
+
+  const auto Info = GetFrameBlockInfo(Thread->CurrentFrame);
+  if (!Info.InlineHeader || HostPC < Header || HostPC >= Header + Info.InlineTail->Size) {
     return false;
   }
   bool Found = false;
-  ForEachRIPEntry(Info, BlockBegin, [&](uint64_t EntryHostPC, uint64_t EntryGuestRIP, unsigned Flags) {
-    if (EntryHostPC == HostPC && (Flags & IR::GuestOpcodeFlags::Exact)) {
+  ForEachRIPEntry(Info, Header, [&](uint64_t EntryHostPC, uint64_t EntryGuestRIP, unsigned, uint32_t) {
+    if (EntryHostPC == HostPC) {
       *RIP = EntryGuestRIP;
-      if (CarryNotInverted) {
-        *CarryNotInverted = (Flags & IR::GuestOpcodeFlags::CarryNotInverted) != 0;
-      }
       Found = true;
-      return false;
     }
-    return EntryHostPC <= HostPC;
+    return EntryHostPC < HostPC;
   });
   return Found;
 }
