@@ -18,6 +18,19 @@
 #include <type_traits>
 
 namespace FEXCore::IR {
+
+// Darwin port: what a GuestOpcode says of the point where a guest instruction begins.
+namespace GuestOpcodeFlags {
+  enum : uint8_t {
+    // All effects of the instructions before it have happened there, in the static registers and the context, and none of its
+    // own: a thread stopped there can start again at the instruction. Passes that move effects over it take this away.
+    Exact = 1 << 0,
+    // The host's carry is the guest's, not its opposite (OpDispatchBuilder::CFInverted is not set).
+    CarryNotInverted = 1 << 1,
+    // What the RIP table keeps.
+    TableMask = Exact | CarryNotInverted,
+  };
+} // namespace GuestOpcodeFlags
 // Darwin port: bit 7 of the OffsetScale of LoadMem, StoreMem, LoadMemTSO and StoreMemTSO marks an Addr that is already a host
 // address (OpDispatchBuilder::HostBase): the backend does not add the guest base to it. It is on the memory operation, not
 // on the address value, because the register allocator replaces a spilled value by a fill that no longer says what it was.
