+// Darwin port: walks the RIP entries of the block the thread is in. F(HostPC, RIP, Flags) of each one, until it returns false.
+template<typename Fn>
+static void ForEachRIPEntry(const GetFrameBlockInfoResult& Info, uint64_t BlockBegin, Fn&& F) {
+  auto [InlineHeader, InlineTail] = Info;
+  const auto Tail = reinterpret_cast<const uint8_t*>(InlineTail);
+  const uint8_t* Flags = Tail + sizeof(*InlineTail);
+  const uint8_t* RIPEntry = Tail + InlineTail->OffsetToRIPEntries;
+  uint64_t EntryHostPC = BlockBegin;
+  uint64_t EntryGuestRIP = InlineTail->RIP;
+
+  for (uint32_t i = 0; i < InlineTail->NumberOfRIPEntries; ++i) {
+    auto Offset = FEXCore::Utils::vl64pair::Decode(RIPEntry);
+    RIPEntry += Offset.Size;
+    EntryHostPC += Offset.IntegerARMPC;
+    EntryGuestRIP += Offset.IntegerX86RIP;
+    if (!F(EntryHostPC, EntryGuestRIP, (Flags[i / 4] >> ((i & 3) * 2)) & IR::GuestOpcodeFlags::TableMask)) {
+      return;
+    }
+  }
+}
